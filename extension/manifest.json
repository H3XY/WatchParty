{
  "manifest_version": 3,
  "name": "WatchParty — Sync & Watch Together",
  "version": "1.0.0",
  "description": "Host or join a watch party on any streaming platform. Sync playback with up to 3 friends in real time.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/socket.io.min.js", "content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "content/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
